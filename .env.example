# Copy to .env at the repo root for local development (read by mcp_server). Never commit .env.
# Keep it out of mcp_server/ and agent/: AgentCore packaging uploads those folders whole.

# Google Safe Browsing API key (Google Cloud Console > APIs & Services > Credentials).
SAFE_BROWSING_API_KEY=

# Inbox source: api (real Gmail) or fixture (simulated inbox, domain ages and threat list from
# ../demo/inbox.json, so the agent can be tested with only AWS credentials).
SCAMSHIELD_GMAIL=api
# SCAMSHIELD_FIXTURE_INBOX=demo/inbox.json

# Secrets: local (token file from connect_gmail.py + SAFE_BROWSING_API_KEY) or agentcore (Identity).
SCAMSHIELD_CREDENTIALS=local
# For agentcore: the MCP server runtime's workload identity (its runtime ID) and provider names.
# SCAMSHIELD_WORKLOAD_NAME=
# SCAMSHIELD_GOOGLE_PROVIDER=scamshield-google
# SCAMSHIELD_SAFE_BROWSING_PROVIDER=scamshield-safe-browsing
# A return URL registered on that workload identity (AgentCore requires one on every token fetch).
# SCAMSHIELD_OAUTH_RETURN_URL=https://scamshield-lac-two.vercel.app/connect/callback

# Where verdicts and user/guardian links live: local (JSON file) or dynamodb.
SCAMSHIELD_STORE=local
# SCAMSHIELD_DYNAMODB_TABLE=ScamShield

# How warnings go out: console (print only) or ses.
SCAMSHIELD_EMAIL_BACKEND=console
# A verified SES identity. In the SES sandbox every recipient must be verified too.
# SCAMSHIELD_SES_FROM=scamshield@example.com

# The hackathon AWS organization only allows AgentCore and Claude in Amazon Bedrock in us-east-1.
SCAMSHIELD_AWS_REGION=us-east-1

# Optional tuning
# SCAMSHIELD_LOOKBACK_DAYS=3
# SCAMSHIELD_MAX_EMAILS=10
# SCAMSHIELD_LABEL=ScamShield
# Set false to rely on AgentCore Policy alone (e.g. for the with/without-Policy eval).
# SCAMSHIELD_TOOL_RECIPIENT_CHECK=true
# Inside AgentCore Runtime:
# SCAMSHIELD_HOST=0.0.0.0
